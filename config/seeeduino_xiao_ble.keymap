#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios =
            <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios =
            <&xiao_d 1 GPIO_ACTIVE_HIGH>,
            <&xiao_d 2 GPIO_ACTIVE_HIGH>,
            <&xiao_d 3 GPIO_ACTIVE_HIGH>,
            <&xiao_d 4 GPIO_ACTIVE_HIGH>,
            <&xiao_d 5 GPIO_ACTIVE_HIGH>;
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Gamepad / WASD Base Layer */
        default_layer {
            bindings = <
                &kp ESC    &kp Q     &kp W     &kp E     &kp R
                &kp TAB    &kp A     &kp S     &kp D     &kp F
                &kp LSHIFT &kp Z     &kp X     &kp C     &kp V
                &none      &none     &none     &mo 1     &kp SPACE
            >;
        };

        /* Layer 1: Fn / Number Layer */
        fn_layer {
            bindings = <
                &to 2      &kp N1    &kp N2    &kp N3    &kp N4
                &kp Y      &kp N5    &kp N6    &kp N7    &kp N8
                &bt BT_CLR &kp N9    &kp N0    &trans    &trans
                &none      &none     &none     &trans    &bt BT_CLR_ALL
            >;
        };

        /* Layer 2: YouTube / Navigation Layer */
        youtube_layer {
            bindings = <
                &to 0      &kp HOME  &kp UP    &kp END   &kp F
                &kp LCTRL  &kp LEFT  &kp DOWN  &kp RIGHT &kp C
                &tog 3     &kp J     &none     &kp L     &none
                &none      &none     &none     &mo 3     &kp SPACE
            >;
        };

        /* Layer 3: Mouse Layer */
        mouse_layer {
            bindings = <
                &none            &mkp LCLK        &mmv MOVE_UP    &mkp RCLK        &none
                &none            &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none
                &to 2            &none            &mkp MCLK       &kp LEFT         &kp RIGHT
                &none            &none            &none           &mkp LCLK        &mkp RCLK
            >;
        };
    };
};
