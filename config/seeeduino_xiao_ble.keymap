#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/matrix_transform.h>

/* Global mouse movement speed (Fast default: 2500) */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 5000  
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>

/* Override default mmv behavior parameters (Fast) */
&mmv {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

/ {
    behaviors {
        /* Define custom slow movement behavior for precision control */
        mmv_slow: mmv_slow {
            compatible = "zmk,behavior-point-device-move";
            #binding-cells = <1>;
            move-value = <1000>;              /* Precision speed: 1000 */
            acceleration-exponent = <1>;      /* Linear acceleration for predictable aiming */
            time-to-max-speed-ms = <300>;
            delay-ms = <0>;
        };
    };

    macros {
        /* Win + X -> U -> S macro to safely put Windows to sleep */
        win_sleep: win_sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <100>;
            tap-ms = <100>;
            bindings
                = <&kp LG(X)>
                , <&kp U>
                , <&kp S>;
        };

        /* Zoom In: Ctrl + Equal (Plus) */
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>
                     , <&macro_tap &kp EQUAL>
                     , <&macro_release &kp LCTRL>;
        };

        /* Zoom Out: Ctrl + Minus */
        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>
                     , <&macro_tap &kp MINUS>
                     , <&macro_release &kp LCTRL>;
        };

        /* Reset Zoom: Ctrl + 0 */
        zoom_reset: zoom_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>
                     , <&macro_tap &kp N0>
                     , <&macro_release &kp LCTRL>;
        };
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios =
            <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&xiao_d 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios =
            <&xiao_d 1 GPIO_ACTIVE_HIGH>,
            <&xiao_d 2 GPIO_ACTIVE_HIGH>,
            <&xiao_d 3 GPIO_ACTIVE_HIGH>,
            <&xiao_d 4 GPIO_ACTIVE_HIGH>,
            <&xiao_d 5 GPIO_ACTIVE_HIGH>;
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Nav / Media / Bluetooth */
        default_layer {
            bindings = <
                &kp ESC     &kp HOME   &kp UP          &kp END             &kp F
                &kp TAB     &kp LEFT   &kp DOWN        &kp RIGHT           &bt BT_SEL 0
                &kp LSHIFT  &kp LCTRL  &bt BT_CLR      &bt BT_CLR_ALL      &bt BT_SEL 1
                &none       &none      &none           &to 1               &kp SPACE
            >;
        };

        /* Layer 1: Normal Mouse Control (2500 Speed) */
        mouse_layer {
            bindings = <
                &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP     &mkp RCLK       &win_sleep
                &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT &zoom_in
                &to 0           &msc SCRL_LEFT  &msc SCRL_RIGHT  &zoom_reset     &zoom_out
                &none           &none           &none            &mo 2           &mkp LCLK
            >;
        };

        /* Layer 2: Precision Mouse Hold (1000 Speed) */
        mouse_slow_layer {
            bindings = <
                &trans          &trans               &mmv_slow MOVE_UP   &trans          &trans
                &trans          &mmv_slow MOVE_LEFT  &mmv_slow MOVE_DOWN &mmv_slow MOVE_RIGHT &trans
                &trans          &trans               &trans              &trans          &trans
                &trans          &trans               &trans              &trans          &trans
            >;
        };
    };
};
